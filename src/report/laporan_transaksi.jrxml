<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC
        "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport name="laporan_transaksi"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <!-- ================= PARAMETER ================= -->
    <parameter name="tgl_awal" class="java.util.Date"/>
    <parameter name="tgl_akhir" class="java.util.Date"/>

    <!-- ================= QUERY ================= -->
    <queryString>
        <![CDATA[
            SELECT 
                t.id_transaksi,
                ow.nama AS nama_wisata,
                t.tanggal,
                t.jumlah_pengunjung,
                t.total_pembayaran
            FROM transaksi t
            JOIN objek_wisata ow ON t.id_wisata = ow.id_wisata
            WHERE t.tanggal BETWEEN $P{tgl_awal} AND $P{tgl_akhir}
            ORDER BY t.tanggal ASC
        ]]>
    </queryString>

    <!-- ================= FIELD ================= -->
    <field name="id_transaksi" class="java.lang.Integer"/>
    <field name="nama_wisata" class="java.lang.String"/>
    <field name="tanggal" class="java.sql.Date"/>
    <field name="jumlah_pengunjung" class="java.lang.Integer"/>
    <field name="total_pembayaran" class="java.lang.Double"/>

    <!-- ================= TITLE ================= -->
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN TRANSAKSI WISATA]]></text>
            </staticText>
        </band>
    </title>

    <!-- ================= COLUMN HEADER ================= -->
    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="50" height="25"/><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement x="50" y="0" width="160" height="25"/><text><![CDATA[Wisata]]></text></staticText>
            <staticText><reportElement x="210" y="0" width="90" height="25"/><text><![CDATA[Tanggal]]></text></staticText>
            <staticText><reportElement x="300" y="0" width="100" height="25"/><text><![CDATA[Jumlah]]></text></staticText>
            <staticText><reportElement x="400" y="0" width="155" height="25"/><text><![CDATA[Total Bayar]]></text></staticText>
        </band>
    </columnHeader>

    <!-- ================= DETAIL ================= -->
    <detail>
        <band height="25">
            <textField><reportElement x="0" y="0" width="50" height="25"/><textFieldExpression><![CDATA[$F{id_transaksi}]]></textFieldExpression></textField>
            <textField><reportElement x="50" y="0" width="160" height="25"/><textFieldExpression><![CDATA[$F{nama_wisata}]]></textFieldExpression></textField>
            <textField><reportElement x="210" y="0" width="90" height="25"/><textFieldExpression><![CDATA[$F{tanggal}]]></textFieldExpression></textField>
            <textField><reportElement x="300" y="0" width="100" height="25"/><textFieldExpression><![CDATA[$F{jumlah_pengunjung}]]></textFieldExpression></textField>
            <textField pattern="Rp #,##0">
                <reportElement x="400" y="0" width="155" height="25"/>
                <textFieldExpression><![CDATA[$F{total_pembayaran}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
